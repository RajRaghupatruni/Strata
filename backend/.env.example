environment=local
database_url=sqlite:///./strata.db
public_demo_mode=false
seed_demo_on_start=false
cors_allowed_origins=

# Render public demo overrides (set these in the service environment):
# database_url=sqlite:////tmp/strata.db
# public_demo_mode=true
# seed_demo_on_start=true
# coaching_ai_enabled=false
# cors_allowed_origins=https://<your-render-frontend>.onrender.com

# Hosted/production persistence should use PostgreSQL and Alembic migrations:
# environment=production
# database_url=postgresql+psycopg://strata:change-me@localhost:5432/strata
# public_demo_mode=true

# Synthetic demo data and deterministic coaching need no credentials.
riot_api_key=
riot_default_region=na

coaching_ai_enabled=false
coaching_mode=deterministic
openai_api_key=
openai_model=gpt-4o-mini
openai_base_url=https://api.openai.com/v1
log_level=INFO
log_format=json
